{
  "name": "{{WORKFLOW_NAME}}",
  "description": "Laue Portal: DM submission, scheduler/Globus monitoring, and result validation",
  "owner": "{{OWNER}}",
  "userAccount": "{{USER_ACCOUNT}}",
  "stages": {
    "01-SUBMIT": {
      "command": "{{STAGE_COMMAND}} submit $submissionId",
      "outputVariableRegexList": [
        "Status: (?P<remoteStatus>.*)",
        "Flow Action ID: (?P<flowID>.*)",
        "URL: (?P<url>.*)"
      ]
    },
    "02-MONITOR": {
      "command": "{{STAGE_COMMAND}} monitor $submissionId",
      "repeatPeriod": 10,
      "repeatUntil": "\"$remoteStatus\" in (\"SUCCEEDED\", \"FAILED\", \"CANCELLED\")",
      "maxRepeats": 17280,
      "outputVariableRegexList": [
        "Status: (?P<remoteStatus>.*)",
        "Observation: (?P<remoteObservation>.*)"
      ]
    },
    "03-CHECK": {
      "command": "{{STAGE_COMMAND}} check $submissionId"
    }
  }
}
