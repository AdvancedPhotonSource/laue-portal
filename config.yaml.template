# Database configuration
db_file: Laue_Records.db

# Default variables for processing
DEFAULT_VARIABLES:
  author: ""
  notes: ""
  root_path: /path/to/experiment
  computer_name: APS
  num_threads: 35
  memory_limit_mb: 50000
  verbose: 1

# Valid HDF file extensions for data files
VALID_HDF_EXTENSIONS:
  - .hdf
  - .h5
  - .hdf5
  - .he5

# Server-side scan log browser
SCAN_LOG_BROWSER:
  default_path: ""
  max_file_size_mb: 100

# Redis server configuration
REDIS_CONFIG:
  host: localhost
  port: 6379

# One queue item runs a complete reconstruction or indexing job.
# job_timeout_seconds: wall-clock limit for one run; exceeded runs are finalized as Failed.
# stale_heartbeat_seconds: a Running job whose heartbeat is older than this is reconciled as interrupted.
# workers / max_in_flight: indexing processes and outstanding inputs per run.
# reconstruction_workers: number of points reconstructed concurrently. Each uses
# DEFAULT_VARIABLES.num_threads threads and its own memory_limit_mb stripe budget.
# Divide those resources among workers to fit the host.
RUN_EXECUTION:
  job_timeout_seconds: 86400
  heartbeat_seconds: 15
  progress_seconds: 5
  cancel_poll_seconds: 2
  stale_heartbeat_seconds: 300
  shutdown_grace_seconds: 600
  workers: 4
  reconstruction_workers: 1

# Optional live arrival source. DM acquisition is managed independently; Start
# and Stop on the Live page only control scientific processing. Authentication
# stays in the existing DM setup/login file, outside the repository.
LIVE:
  dm:
    enabled: false
    setup_file: /path/to/dm.setup.sh
    timeout_seconds: 15
    poll_seconds: 2
  defaults: {}

DASH_CONFIG:
  host: localhost
  port: 2082
  debug: false

# Peak indexing default parameters
PEAKINDEX_DEFAULTS:
  # File/scan parameters (typically overridden per job)
  scanPoints: ""            # Empty string - user must provide
  depthRange: ""            # Empty string - optional
  
  # Processing parameters
  threshold: null           # Auto-detect if empty
  thresholdRatio: null      # Auto-detect if empty
  maxRfactor: 0.5
  boxsize: 18
  max_number: 300
  min_separation: 20
  peakShape: "Lorentzian"
  min_size: 3
  max_peaks: 200
  smooth: false
  
  # Indexing parameters
  indexKeVmaxCalc: 17.2
  indexKeVmaxTest: 35.0
  indexAngleTolerance: 0.1
  indexH: 0
  indexK: 0
  indexL: 1
  indexCone: 72.0
  
  # Detector crop (full detector)
  detectorCropX1: 0
  detectorCropX2: 2047
  detectorCropY1: 0
  detectorCropY2: 2047
  
  # Units
  energyUnit: "keV"
  exposureUnit: "sec"
  recipLatticeUnit: "1/nm"
  latticeParametersUnit: "nm"
  
  # File paths (relative to root_path)
  outputFolder: "analysis/scan_%d/index_%d"
  outputXML: "output.xml"   
  geoFile: "config/geometry.xml"
  crystFile: "config/crystal.xml"
  maskFile: "None"
  
  # Other
  beamline: "34ID-E"
  depth: .nan              # YAML nan value

# Wire reconstruction default parameters
WIRERECON_DEFAULTS:
  # Recon constraints
  geoFile: "config/geometry.xml"
  percent_brightest: 100
  wire_edges: "leading"

  # Depth parameters
  depth_start: -50
  depth_end: 150
  depth_resolution: 1

  # Leading stored slices and wire-vector entries skipped (reconstructN_cpu uses 1 and 1)
  frame_skip: 1
  wire_skip: 1

  # Output
  outputFolder: "analysis/scan_%d/rec_%d/data"

# Motor groups configuration
MOTOR_GROUPS:
  sample:
    - 34ide:mxv:c0:m1      # Sample X
    - 34ide:mxv:c0:m3      # Sample Y
    - 34ide:mxv:c0:m2      # Sample Z
    - 34ide:focusTHK:F     # Sample F
    - 34ide:focusTHK:H     # Sample H
  
  energy:
    - 34ide:monoE:keV
  
  depth:  # wire or coded aperture
    - 34ide:t80:c0:m1      # WireBase X
    - 34ide:t80:c0:m3      # WireBase Y
    - 34ide:t80:c0:m2      # WireBase Z
    - 34ide:focusAlio:F    # WireBase F
    - 34ide:focusAlio:H    # WireBase H
    - 34ide:mxv:c0:m4      # WireScan_H
    # - 34ide:aero:c0:m1   # Wire stage <2015
  
  other:
    - 34ide:m58:c0:m6
    - 34ide:m58:c0:m8
    - 34ide:m58:c1:m1
    - 34ide:m58:c1:m2      # L_slit_vert
    - 34ide:m58:c1:m3      # L_slit_horiz
    - 34ide:m58:c1:m5
    - 34ide:m58:c1:m7
    - 34ide:540:c0:out2
    - 34ide:540:c0:out3
    - 34ide:float6

# DM integration is opt-in. Keep its storage/launcher configuration separate.
BDP:
  enabled: false
  settings_file: /path/to/portal/config/bdp.yaml
